{
  "expo": {
    "name": "PayPlace",
    "description": "A welcoming place to plan your budget, bills, and debt—without shame.",
    "icon": "./assets/branding/payplace-icon.png",
    "slug": "payplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/branding/payplace-icon.png"
    },
    "ios": {
      "icon": "./assets/branding/payplace-icon.png",
      "bundleIdentifier": "com.davelabranchejr.payplace",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "com.davelabranchejr.payplace"
    },
    "owner": "pilotpay",
    "extra": {
      "eas": {
        "projectId": "4be1e462-b04c-492b-bb9e-d922655dba9f"
      }
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow PayPlace to use Face ID to protect your budget and encrypted backups."
        }
      ]
    ]
  }
}
